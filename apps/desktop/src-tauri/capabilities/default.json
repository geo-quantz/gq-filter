{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may do: pick files, ask before overwriting, and call the app's commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "allow-cli-status",
    "allow-inspect-input",
    "allow-prepare-output",
    "allow-run-filter",
    "allow-cancel-run"
  ]
}
